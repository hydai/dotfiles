# oh-my-zsh path
ZSH=$HOME/.oh-my-zsh
ZSH_CUSTOM=${ZSH_CUSTOM:-$ZSH/custom}
ZSH_THEME="hydai"

export TERM=xterm-256color

OS_NAME="$(uname -s)"

# Helper functions
source_if_exists() {
  local file="$1"
  [[ -f "$file" ]] && source "$file"
}

prepend_path() {
  local dir="$1"
  [[ -d "$dir" ]] || return
  PATH="$dir:$PATH"
}

# Load OS-specific overrides
case "$OS_NAME" in
  Darwin)
    source_if_exists "$ZSH_CUSTOM/os/darwin.zsh"
    ;;
  FreeBSD)
    source_if_exists "$ZSH_CUSTOM/os/freebsd.zsh"
    ;;
  Linux)
    if command -v apt >/dev/null; then
      source_if_exists "$ZSH_CUSTOM/os/debian.zsh"
    fi
    ;;
  *)
    echo 'Unknown OS!'
    ;;
esac

# Homebrew (if available)
BREW_BIN=""
if [[ -x /opt/homebrew/bin/brew ]]; then
  BREW_BIN=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
  BREW_BIN=/usr/local/bin/brew
elif command -v brew >/dev/null; then
  BREW_BIN=$(command -v brew)
fi

if [[ -n "$BREW_BIN" ]]; then
  eval "$("$BREW_BIN" shellenv)"
  BREW_PREFIX="$("$BREW_BIN" --prefix 2>/dev/null)"
  alias brews="brew list -1"
fi

# Oh My Zsh plugins
plugins=(git gitignore zsh-syntax-highlighting zsh-autosuggestions docker docker-compose asdf)

source "$ZSH/oh-my-zsh.sh"

prepend_path "/usr/local/bin"
prepend_path "/usr/local/sbin"

if [[ "$OS_NAME" == "Darwin" ]] && [[ -x /usr/libexec/java_home ]]; then
  export JAVA_HOME=$(/usr/libexec/java_home)
fi

# Git
alias gc="git cherry-pick"
alias gb="git branch"
alias gs="git status"
alias gr="git rebase"
alias gf="git fetch"
alias gbt="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative"

# Docker
alias dpa="docker ps -a"
alias di="docker images"
alias dr="docker rm"
alias ds="docker start"
alias dp="docker pull"
alias dri="docker rmi"

# crictl
alias cpa="sudo crictl ps -a"
alias ci="sudo crictl images"
alias cr="sudo crictl rm"
alias cs="sudo crictl start"
alias cl="sudo crictl logs"

if [[ "$OS_NAME" == "Darwin" ]]; then
  alias missionRst="osascript -e 'quit application \"Dock\"'"
  alias tmopton="sudo sysctl debug.lowpri_throttle_enabled=0"
  alias tmoptoff="sudo sysctl debug.lowpri_throttle_enabled=1"
fi

if [[ -n "$BREW_PREFIX" ]]; then
  prepend_path "$BREW_PREFIX/opt/openjdk@11/bin"
  prepend_path "$BREW_PREFIX/opt/llvm@16/bin"
  if [[ -d "$BREW_PREFIX/opt/llvm@17/lib/cmake" ]]; then
    export LLVM_DIR="$BREW_PREFIX/opt/llvm@17/lib/cmake"
  fi
fi

if [[ -n "$BREW_BIN" ]]; then
  NVM_FROM_BREW="$("$BREW_BIN" --prefix nvm 2>/dev/null)/nvm.sh"
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
elif [[ -n "$NVM_FROM_BREW" ]]; then
  source_if_exists "$NVM_FROM_BREW"
fi

if [[ -n "$BREW_BIN" ]]; then
  ASDF_PREFIX="$("$BREW_BIN" --prefix asdf 2>/dev/null)"
  if [[ -n "$ASDF_PREFIX" ]]; then
    source_if_exists "$ASDF_PREFIX/libexec/asdf.sh"
    ASDF_LOADED=1
  fi
fi

if [[ -z "$ASDF_LOADED" ]]; then
  source_if_exists "$HOME/.asdf/asdf.sh"
fi

# Try common autojump locations so Linux and macOS work the same
AUTOJUMP_CANDIDATES=(
  "/usr/local/etc/profile.d/autojump.sh"
  "${BREW_PREFIX:+$BREW_PREFIX/etc/profile.d/autojump.sh}"
  "/usr/share/autojump/autojump.zsh"
)
for candidate in "${AUTOJUMP_CANDIDATES[@]}"; do
  [[ -f "$candidate" ]] && source "$candidate" && break
done
unset AUTOJUMP_CANDIDATES

source_if_exists "$HOME/.fzf.zsh"
source_if_exists "$HOME/.cargo/env"
source_if_exists "$HOME/.wasmedge/env"

export GPG_TTY=$(tty)

export WASMTIME_HOME="$HOME/.wasmtime"
prepend_path "$WASMTIME_HOME/bin"
prepend_path "$HOME/.local/bin"

export JOBS=max

unset ASDF_LOADED NVM_FROM_BREW

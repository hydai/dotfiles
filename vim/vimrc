    " Comments {
        function! s:CommentToggleRequired(first, last, want_commented) abort
            if empty(&l:commentstring) || !&l:modifiable
                return 0
            endif

            let l:commentstring = substitute(
                        \ substitute(&l:commentstring, '\S\zs%s\s*', ' %s', ''),
                        \ '%s\ze\S', '%s ', '')
            let l:parts = split(
                        \ escape(l:commentstring, '*.\^$['), '\s*%s\s*')

            if empty(l:parts)
                return 0
            endif

            if len(l:parts) == 1
                call add(l:parts, '')
            endif

            let l:all_commented = 1
            for l:line_number in range(a:first, a:last)
                let l:line = getline(l:line_number)
                if l:line !~# '^\s*$'
                            \ && l:line !~? '^\s*' . l:parts[0]
                            \ . '.*' . l:parts[1] . '$'
                    let l:all_commented = 0
                    break
                endif
            endfor

            return a:want_commented ? !l:all_commented : l:all_commented
        endfunction

        function! s:CommentLineMapping(want_commented) abort
            return s:CommentToggleRequired(
                        \ line('.'), line('.'), a:want_commented)
                        \ ? "\<Plug>(comment-toggle-line)" : ''
        endfunction

        function! s:CommentSelectionMapping(want_commented) abort
            let l:first = min([line('.'), line('v')])
            let l:last = max([line('.'), line('v')])
            return s:CommentToggleRequired(
                        \ l:first, l:last, a:want_commented)
                        \ ? "\<Plug>(comment-toggle)" : "\<Esc>"
        endfunction

        nmap <silent><expr> <leader>cc <SID>CommentLineMapping(1)
        xmap <silent><expr> <leader>cc <SID>CommentSelectionMapping(1)
        nmap <silent><expr> <leader>cu <SID>CommentLineMapping(0)
        xmap <silent><expr> <leader>cu <SID>CommentSelectionMapping(0)
        nmap <silent> <leader>co <Plug>(comment-toggle-line)
        xmap <silent> <leader>co <Plug>(comment-toggle)
    " }

